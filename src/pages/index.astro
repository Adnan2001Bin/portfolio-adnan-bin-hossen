---
/**
 * index.astro — Homepage
 *
 * Single long-scroll page with all portfolio sections.
 * Sections are built one phase at a time.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Mosaic from "@/components/sections/Mosaic.astro";
import Stats from "@/components/sections/Stats.astro";
import Features from "@/components/sections/Features.astro";
---

<BaseLayout>
  <main id="main-content">
    <!-- Phase 2: Hero + morph -->
    <Hero />

    <!-- Phase 3: Mosaic + centerpiece -->
    <Mosaic />

    <!-- Phase 4: Stats + sticky features -->
    <Stats />
    <Features />
    <!-- Phase 5: Process systems -->
    <!-- Phase 6: Case study device -->
    <!-- Phase 7: Steps + testimonials -->
    <!-- Phase 8: Final CTA + 3D + footer -->

    <!-- Spacer so the morph has somewhere to unpin into -->
    <section
      class="relative py-32 sm:py-40 md:py-48"
      style="background: var(--t-bg)"
    >
      <div class="section-container text-center">
        <p class="text-sm tracking-widest uppercase" style="color: var(--t-muted)">
          Next sections in progress
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
