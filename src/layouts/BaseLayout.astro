---
/**
 * BaseLayout.astro
 * Root HTML shell for every page.
 *
 * Responsibilities:
 * - <html> with dark-class support (theme flash prevention)
 * - Font loading via @fontsource
 * - Global CSS import
 * - Header component
 * - Smooth scroll + GSAP init (via shared module)
 * - <slot /> for page content
 */

import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/dm-sans";
import "@/styles/global.css";

import Header from "@/components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Adnan Bin Hossen — Full-Stack Developer",
  description = "Full-stack products that scale cleanly — from interface to API.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme flash prevention — runs before paint -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        var theme = stored || (prefersDark ? "dark" : "light");
        if (theme === "dark") document.documentElement.classList.add("dark");
        document.documentElement.classList.remove("no-js");
      })();
    </script>
  </head>

  <body>
    <Header />

    <slot />

    <!-- Smooth scroll + GSAP init (deferred module) -->
    <script>
      import "../scripts/smooth-scroll";
    </script>
  </body>
</html>
