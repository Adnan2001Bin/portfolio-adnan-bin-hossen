---
/**
 * Hero.astro
 * Full-viewport hero section with scroll-driven stadium morph.
 *
 * Numa reference pattern:
 * - Full-bleed dark background (video in Numa; gradient placeholder here)
 * - Large white headline, subcopy, CTA at bottom-left
 * - On scroll: content fades out, frame gains border-radius + inset → stadium shape
 * - Background (theme surface) revealed around the morphed frame
 *
 * Animation: GSAP ScrollTrigger pin + scrub
 */

import { siteConfig } from "@/data/navigation";
---

<section
  id="hero-section"
  class="relative w-full"
  style="background: var(--t-bg)"
  aria-label="Hero"
>
  <!-- The hero frame that morphs on scroll -->
  <div
    id="hero-frame"
    class="relative w-full h-screen overflow-hidden"
    style="border-radius: 0;"
  >
    <!-- Gradient background (placeholder — replace with portrait/creative still later) -->
    <div class="absolute inset-0 hero-gradient" aria-hidden="true"></div>

    <!-- Subtle grid pattern overlay -->
    <div class="absolute inset-0 hero-grid" aria-hidden="true"></div>

    <!-- Vignette overlay for depth -->
    <div class="absolute inset-0 hero-vignette" aria-hidden="true"></div>

    <!-- Placeholder badge -->
    <div class="absolute top-24 right-6 sm:right-10 z-20">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-medium tracking-wider uppercase text-white/50 backdrop-blur-sm"
      >
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent-soft animate-pulse"></span>
        Placeholder — add portrait
      </span>
    </div>

    <!-- Hero content — bottom-left aligned (Numa pattern) -->
    <div
      id="hero-content"
      class="relative z-10 h-full flex flex-col justify-end section-container pb-10 sm:pb-14 md:pb-16 lg:pb-20"
    >
      <!-- Headline -->
      <h1 class="font-display text-[clamp(2.25rem,6.5vw,6.5rem)] font-bold text-white leading-[1.05] tracking-tight mb-5 md:mb-6 max-w-5xl">
        <span class="hero-title-line block overflow-hidden">
          <span class="block">Full-stack products</span>
        </span>
        <span class="hero-title-line block overflow-hidden">
          <span class="block text-accent-soft">that scale cleanly</span>
        </span>
      </h1>

      <!-- Subcopy -->
      <p
        id="hero-subcopy"
        class="text-[clamp(0.875rem,1.5vw,1.25rem)] text-white/60 max-w-lg mb-7 md:mb-8 leading-relaxed"
      >
        From interface to API — building robust, beautiful applications that perform at scale.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-8 md:mb-10">
        <a
          href={siteConfig.primaryCTA.href}
          class="hero-cta inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 sm:py-3.5 text-sm sm:text-base font-semibold text-gray-900 transition-all duration-200 hover:bg-white/90 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98]"
        >
          {siteConfig.primaryCTA.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M1 7h12M8 2l5 5-5 5" />
          </svg>
        </a>
        <a
          href={siteConfig.secondaryCTA.href}
          class="hero-cta inline-flex items-center gap-2 rounded-full border border-white/20 px-7 py-3 sm:py-3.5 text-sm sm:text-base font-semibold text-white/80 transition-all duration-200 hover:bg-white/10 hover:scale-[1.02] active:scale-[0.98]"
        >
          {siteConfig.secondaryCTA.label}
        </a>
      </div>

      <!-- Identity bar -->
      <div class="flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-1 text-white/35 text-xs sm:text-sm">
        <span>{siteConfig.name}</span>
        <span aria-hidden="true">·</span>
        <span>{siteConfig.role}</span>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <span class="hidden sm:inline">{siteConfig.location}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Hero gradient (cinematic dark atmosphere with emerald accents) ---- */
  .hero-gradient {
    background:
      radial-gradient(ellipse at 20% 100%, rgba(14, 159, 110, 0.18) 0%, transparent 45%),
      radial-gradient(ellipse at 85% 15%, rgba(52, 211, 153, 0.07) 0%, transparent 35%),
      radial-gradient(ellipse at 50% 50%, #0c1f3a 0%, transparent 65%),
      linear-gradient(170deg, #050d1a 0%, #0a1628 35%, #071321 70%, #030a14 100%);
  }

  /* ---- Subtle grid overlay (tech aesthetic) ---- */
  .hero-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 60%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 60%, black 20%, transparent 70%);
  }

  /* ---- Vignette for cinema depth ---- */
  .hero-vignette {
    background: radial-gradient(ellipse at 50% 40%, transparent 35%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
  }

  /* ---- Reduced motion: skip entrance stagger ---- */
  @media (prefers-reduced-motion: reduce) {
    .hero-title-line span,
    #hero-subcopy,
    .hero-cta {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const heroSection = document.getElementById("hero-section");
    const heroFrame = document.getElementById("hero-frame");
    const heroContent = document.getElementById("hero-content");
    const header = document.getElementById("site-header");

    if (!heroSection || !heroFrame || !heroContent) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // ── Entrance animation ──
    if (!prefersReducedMotion) {
      const titleLines = heroSection.querySelectorAll(".hero-title-line > span");
      const subcopy = document.getElementById("hero-subcopy");
      const ctas = heroSection.querySelectorAll(".hero-cta");

      const entrance = gsap.timeline({ delay: 0.3 });

      entrance.from(titleLines, {
        y: "100%",
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.12,
      });

      entrance.from(
        subcopy,
        { opacity: 0, y: 20, duration: 0.6, ease: "power2.out" },
        "-=0.4"
      );

      entrance.from(
        ctas,
        { opacity: 0, y: 16, duration: 0.5, ease: "power2.out", stagger: 0.1 },
        "-=0.3"
      );
    }

    // ── Header: start transparent ──
    if (header) {
      header.classList.add("header-transparent");
    }

    // ── Skip morph if reduced motion ──
    if (prefersReducedMotion) return;

    // ── Scroll-driven morph animation ──
    // Responsive morph values
    const isMobile = window.innerWidth < 768;
    const morphInset = isMobile ? "0.75rem" : "2rem";
    const morphInsetX = isMobile ? "0.5rem" : "2.5rem";
    const morphRadius = isMobile ? "1.5rem" : "2.5rem";

    const morphTl = gsap.timeline({
      scrollTrigger: {
        trigger: heroSection,
        start: "top top",
        end: "+=100%",
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
        onUpdate: (self) => {
          if (!header) return;
          if (self.progress > 0.25) {
            header.classList.remove("header-transparent");
            header.classList.add("scrolled");
          } else {
            header.classList.add("header-transparent");
            header.classList.remove("scrolled");
          }
        },
      },
    });

    // Content fades out (0 → 0.35)
    morphTl.to(
      heroContent,
      {
        opacity: 0,
        y: -50,
        duration: 0.35,
        ease: "power2.in",
      },
      0
    );

    // Frame morphs to stadium shape (0.1 → 1.0)
    morphTl.to(
      heroFrame,
      {
        borderRadius: morphRadius,
        marginTop: morphInset,
        marginRight: morphInsetX,
        marginBottom: morphInset,
        marginLeft: morphInsetX,
        duration: 0.9,
        ease: "power2.inOut",
      },
      0.1
    );
  }

  // ── Init ──
  initHero();
  document.addEventListener("astro:after-swap", initHero);
</script>
